---
import { BOT_URL, DOCS, localePath, type Lang } from "../i18n/config";
import { t } from "../i18n/ui";
import Icon from "./Icon.astro";
import TelegramIcon from "./TelegramIcon.astro";
import LangSwitcher from "./LangSwitcher.astro";

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const ui = t(lang);
const links = [
  { slug: "", label: ui.nav.home },
  ...DOCS.map((d) => ({ slug: d, label: ui.nav.docs[d] })),
];
---

<header class="sticky top-0 z-50 border-b border-line bg-white/90 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-3">
      <a href={localePath(lang)} class="flex shrink-0 items-center gap-2.5" aria-label={ui.a11y.home}>
        <img src="/images/logo-96.png" alt="" width="40" height="40" class="h-10 w-10" />
        <span class="hidden text-lg font-bold text-ink sm:block">{ui.brand}</span>
      </a>

      <div class="flex items-center gap-2">
        <LangSwitcher lang={lang} slug={slug} />
        <a
          href={BOT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center gap-2 rounded-full bg-accent px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent/90 md:flex"
        >
          <TelegramIcon />
          {ui.cta.issue}
        </a>
        <button
          type="button"
          class="rounded-lg p-2 text-muted transition-colors hover:bg-surface hover:text-ink lg:hidden"
          aria-label={ui.a11y.menu}
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <span data-menu-icon="open"><Icon name="menu" class="h-6 w-6" /></span>
          <span data-menu-icon="close" hidden><Icon name="x" class="h-6 w-6" /></span>
        </button>
      </div>
    </div>

    <!-- Desktop: document links in a second row so long RU/PT labels always fit -->
    <nav class="-mx-2 hidden h-11 items-center gap-0.5 overflow-x-auto border-t border-line lg:flex xl:gap-1">
      {
        links.map((l) => (
          <a
            href={localePath(lang, l.slug)}
            aria-current={l.slug === slug ? "page" : undefined}
            class:list={[
              "whitespace-nowrap rounded-lg px-2 py-1.5 text-[13px] font-medium transition-colors xl:px-2.5 xl:text-sm",
              !l.slug && "hidden xl:block",
              l.slug === slug ? "bg-accent/10 text-accent-ink" : "text-muted hover:bg-surface hover:text-ink",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div id="mobile-menu" class="border-t border-line py-4 lg:hidden" hidden>
      <nav class="flex flex-col gap-1">
        {
          links.map((l) => (
            <a
              href={localePath(lang, l.slug)}
              aria-current={l.slug === slug ? "page" : undefined}
              class:list={[
                "rounded-lg px-4 py-3 text-sm font-medium transition-colors",
                l.slug === slug ? "bg-accent/10 text-accent-ink" : "text-muted hover:bg-surface hover:text-ink",
              ]}
            >
              {l.label}
            </a>
          ))
        }
        <a
          href={BOT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 flex items-center justify-center gap-2 rounded-full bg-accent px-5 py-3 font-semibold text-white hover:bg-accent/90"
        >
          <TelegramIcon />
          {ui.cta.issue}
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    if (!menu) return;
    const open = menu.hidden;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.querySelector<HTMLElement>('[data-menu-icon="open"]')!.hidden = open;
    toggle.querySelector<HTMLElement>('[data-menu-icon="close"]')!.hidden = !open;
  });
</script>
